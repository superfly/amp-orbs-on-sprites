#!/bin/sh
set -eu
cd "$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
if ! command -v node >/dev/null 2>&1; then
  printf '%s\n' 'Setup needs Node.js 22 or newer. Install it from https://nodejs.org, then run ./setup again.' >&2
  exit 1
fi
node -e 'if (Number(process.versions.node.split(".")[0]) < 22) { console.error("Setup needs Node.js 22 or newer: https://nodejs.org"); process.exit(1); }'
exec node provision/setup.mjs "$@"
