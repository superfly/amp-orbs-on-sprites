# Optional: ./setup creates a provider automatically when this is unset.
# For an existing provider or local development, copy to .env.local (chmod 600).
AMP_ORB_PROVIDER_TOKEN=
# Local controller only. Leave unset for ./setup, which generates a unique
# prefix (or pass --provider). Keep stable and unique among providers in an org.
# SPRITES_PROVIDER_ID=mcp-amp
# The launcher defaults to .state/ in this repository.
# SPRITES_STATE_DIR=/absolute/path/to/persistent/state
# Optional when the Sprite CLI is already signed in:
# SPRITE_TOKEN=
# SPRITE_BIN=sprite
# Pin the controller/Orb Amp release if desired:
# SPRITES_AMP_VERSION=0.0.1793707234-gc72860
