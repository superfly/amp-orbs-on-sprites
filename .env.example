# Copy to .env.local, keep private (chmod 600), and fill in your Amp token.
AMP_ORB_PROVIDER_TOKEN=
# Optional; keep stable and unique among providers in an organization.
SPRITES_PROVIDER_ID=mcp-amp
# The launcher defaults to .state/ in this repository.
# SPRITES_STATE_DIR=/absolute/path/to/persistent/state
# Optional when the Sprite CLI is already signed in:
# SPRITE_TOKEN=
# SPRITE_BIN=sprite
# Pin the controller/Orb Amp release if desired:
# SPRITES_AMP_VERSION=0.0.1793707234-gc72860
